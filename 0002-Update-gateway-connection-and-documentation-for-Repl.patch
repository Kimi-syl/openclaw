diff --git a/.replit b/.replit
index 38d8098b13..6309543c21 100644
--- a/.replit
+++ b/.replit
@@ -21,14 +21,14 @@ args = "Start application"
 name = "Start application"
 author = "agent"
 
+[workflows.workflow.metadata]
+outputType = "webview"
+
 [[workflows.workflow.tasks]]
 task = "shell.exec"
-args = "cd ui && COREPACK_ENABLE_STRICT=0 pnpm run dev"
+args = "bash -c 'COREPACK_ENABLE_STRICT=0 node scripts/run-node.mjs --dev gateway & cd ui && COREPACK_ENABLE_STRICT=0 pnpm run dev'"
 waitForPort = 5000
 
-[workflows.workflow.metadata]
-outputType = "webview"
-
 [[ports]]
 localPort = 5000
 externalPort = 80
@@ -37,3 +37,12 @@ externalPort = 80
 deploymentTarget = "static"
 build = ["bash", "-c", "cd ui && COREPACK_ENABLE_STRICT=0 pnpm run build"]
 publicDir = "dist/control-ui"
+
+[userenv]
+
+[userenv.shared]
+OPENCLAW_GATEWAY_TOKEN = "replit-dev-key-change-in-production"
+GOOGLE_API_KEY = "AIzaSyAV_TNL3szP6EdDIjbniAVDSWF-ga9f-vs"
+OPENCLAW_SKIP_CHANNELS = "1"
+CLAWDBOT_SKIP_CHANNELS = "1"
+OPENCLAW_BIND = "0.0.0.0"
