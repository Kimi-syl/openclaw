diff --git a/scripts/start-dev.sh b/scripts/start-dev.sh
new file mode 100755
index 0000000000..8bd56dfee1
--- /dev/null
+++ b/scripts/start-dev.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+set -e
+
+echo "==> Clearing stuck processes and ports..."
+fuser -k 5000/tcp 2>/dev/null || true
+fuser -k 19001/tcp 2>/dev/null || true
+pkill -9 -f "openclaw-gateway" 2>/dev/null || true
+sleep 1
+
+echo "==> Writing gateway config..."
+mkdir -p ~/.openclaw-dev ~/.openclaw/workspace-dev
+
+cat > ~/.openclaw-dev/openclaw.json << 'GATEWAYCONFIG'
+{
+  "agents": {
+    "defaults": {
+      "workspace": "/home/runner/.openclaw/workspace-dev",
+      "skipBootstrap": true
+    },
+    "list": [
+      {
+        "id": "dev",
+        "default": true,
+        "workspace": "/home/runner/.openclaw/workspace-dev",
+        "identity": {
+          "name": "OpenClaw Dev",
+          "theme": "assistant",
+          "emoji": "🦞"
+        }
+      }
+    ]
+  },
+  "commands": {
+    "native": "auto",
+    "nativeSkills": "auto",
+    "restart": true,
+    "ownerDisplay": "raw"
+  },
+  "gateway": {
+    "mode": "local",
+    "bind": "loopback",
+    "auth": {
+      "mode": "none"
+    },
+    "trustedProxies": ["0.0.0.0/0"],
+    "controlUi": {
+      "allowInsecureAuth": true,
+      "dangerouslyDisableDeviceAuth": true,
+      "allowedOrigins": ["*"]
+    }
+  },
+  "meta": {
+    "lastTouchedVersion": "2026.3.8",
+    "lastTouchedAt": "2026-03-12T00:00:00.000Z"
+  }
+}
+GATEWAYCONFIG
+
+echo "==> Config written. Starting gateway + UI..."
+COREPACK_ENABLE_STRICT=0 node scripts/run-node.mjs --dev gateway &
+cd ui && COREPACK_ENABLE_STRICT=0 pnpm run dev
