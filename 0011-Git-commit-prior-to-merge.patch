-  if (data.surfaceId === undefined) {
-    errors.push("SurfaceUpdate must have a 'surfaceId' property.");
-  }
-  if (!data.components || !Array.isArray(data.components)) {
-    errors.push("SurfaceUpdate must have a 'components' array.");
