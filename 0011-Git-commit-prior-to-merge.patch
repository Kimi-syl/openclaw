-    const message: Types.A2UIClientEventMessage = {
-      userAction: {
-        name: action.name,
-        sourceComponentId: component.id,
-        surfaceId: surfaceId!,
-        timestamp: new Date().toISOString(),
-        context,
-      },
-    };
-
-    return this.processor.dispatch(message);
-  }
