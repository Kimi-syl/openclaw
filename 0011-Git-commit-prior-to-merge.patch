-  }
-  const validateValueProperty = (
-    item: any,
-    itemErrors: string[],
-    prefix: string,
-  ) => {
-    const valueProps = [
-      "valueString",
-      "valueNumber",
-      "valueBoolean",
-      "valueMap",
-    ];
-    let valueCount = 0;
-    let foundValueProp = "";
