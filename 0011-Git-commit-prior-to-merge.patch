-            background-color: light-dark(oklch(from var(${toProp(
-              key
-            )}) l c h / calc(alpha * ${o.toFixed(1)})), oklch(from var(${toProp(
-            inverseKey
-          )}) l c h / calc(alpha * ${o.toFixed(1)})) );
