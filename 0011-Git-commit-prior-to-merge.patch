-            key
-          )}), var(${toProp(inverseKey)})); }`,
-          `.color-bbgc-${key}::backdrop { background-color: light-dark(var(${toProp(
-            key
-          )}), var(${toProp(inverseKey)})); }`,
-        ];
-
-        for (let o = 0.1; o < 1; o += 0.1) {
